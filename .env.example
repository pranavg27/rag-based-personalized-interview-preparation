# Copy to .env and fill in. NEVER commit .env.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501

# ---------- Auth ----------
# generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=interview_prep
CHECKPOINTER=mongo                 # mongo | memory (memory loses threads on restart)
CHECKPOINT_COLLECTION=langgraph_checkpoints
CHECKPOINT_WRITES_COLLECTION=langgraph_checkpoint_writes

# ---------- LLM: Meta Llama via Hugging Face Inference Providers ----------
HF_TOKEN=hf_xxx                    # fine-grained token with "Make calls to Inference Providers"
LLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct   # any compatible Meta Llama instruct model
HF_PROVIDER=auto                   # auto | a specific provider name (see README)
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=1024
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ---------- Embeddings / reranker ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=true              # set false on low-resource machines
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------- Vector store ----------
VECTOR_STORE=chroma                # chroma | faiss
CHROMA_MODE=persistent             # persistent | http (use http when MCP servers run as separate processes)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=study_materials
FAISS_INDEX_DIR=./data/faiss
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
SIMILARITY_THRESHOLD=0.35
RAG_ALLOW_GENERAL_FALLBACK=true

# ---------- Uploads ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
ALLOWED_RESUME_TYPES=pdf
ALLOWED_DOC_TYPES=pdf,txt,docx

# ---------- Adaptive difficulty / memory ----------
DIFFICULTY_UP_THRESHOLD=8.0
DIFFICULTY_DOWN_THRESHOLD=5.0
DIFFICULTY_WINDOW=3
WEAK_TOPIC_THRESHOLD=6.0
STRONG_TOPIC_THRESHOLD=8.0
MIN_ATTEMPTS_FOR_TOPIC=2
MEMORY_PROGRESS_KEEP=20
# Optional rubric override (criterion -> weight):
# EVAL_RUBRIC_JSON={"technical_correctness":0.4,"completeness":0.2,"clarity":0.2,"use_of_examples":0.2}

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute

# ---------- MCP ----------
MCP_MODE=embedded                  # embedded (mounted in FastAPI) | external (python scripts/run_mcp_servers.py) | disabled
MCP_FALLBACK_LOCAL=true            # call the same code in-process if a server is unreachable
MCP_INTERNAL_TOKEN=change-me-shared-secret
MCP_RESUME_URL=http://localhost:8101/mcp
MCP_QUESTIONS_URL=http://localhost:8102/mcp
MCP_ANALYTICS_URL=http://localhost:8103/mcp
MCP_JD_URL=http://localhost:8104/mcp
MCP_TIMEOUT_SECONDS=90

# ---------- LangSmith (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-interview-prep
